#!/usr/bin/env python3
"""
play — play a file or URL on the remote mpv server.

Usage:
    play [--replace | --append] [--host HOST] INPUT [INPUT ...]

INPUT is either:
  * a URL (http/https/rtsp/rtmp/magnet/ytdl://) — sent straight to mpv,
    which will use yt-dlp for sites it supports
  * a path to a local file — uploaded to the remote first, then played

By default new inputs are appended to the playlist and playback starts.
Use --append to queue without starting, --replace to replace the current
item. HOST defaults to $PLAY_HOST, or "balthazar".
"""
from __future__ import annotations

import argparse, hashlib, json, os, shlex, subprocess, sys, time
from pathlib import Path
from urllib.parse import urlparse

URL_SCHEMES = {"http", "https", "rtsp", "rtmp", "rtmps", "mms", "magnet", "ytdl"}
REMOTE_UPLOAD_DIR = ".cache/remote-mpv/uploads"   # relative to remote $HOME

SSH_OPTS = [
    "-o", "BatchMode=yes",
    "-o", "ConnectTimeout=10",
    "-o", "ServerAliveInterval=30",
]


def is_url(s: str) -> bool:
    return s.startswith("magnet:") or urlparse(s).scheme in URL_SCHEMES


def main() -> int:
    ap = argparse.ArgumentParser(add_help=True)
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--replace", action="store_true")
    mode.add_argument("--append", action="store_true")
    ap.add_argument("--host", default=os.environ.get("PLAY_HOST", "balthazar"))
    ap.add_argument("inputs", nargs="+")
    args = ap.parse_args()

    mpv_mode = "replace" if args.replace else "append" if args.append else "append-play"
    host = args.host

    def ssh(cmd: str, *, input: bytes | None = None, check: bool = True
            ) -> subprocess.CompletedProcess:
        return subprocess.run(
            ["ssh", *SSH_OPTS, host, cmd],
            input=input, capture_output=True, check=check,
        )

    def ipc(*cmd: str) -> dict:
        r = ssh("~/.local/bin/mpv-ipc " + " ".join(shlex.quote(a) for a in cmd))
        return json.loads(r.stdout.decode() or "{}")

    def daemon_alive() -> bool:
        try:
            ipc("get_property", "idle-active")
            return True
        except Exception:
            return False

    def ensure_daemon() -> None:
        if daemon_alive():
            return
        # Detach completely so ssh can return.
        ssh("setsid nohup ~/.local/bin/mpv-daemon "
            ">/tmp/mpv-daemon.log 2>&1 </dev/null & disown")
        for _ in range(60):
            time.sleep(0.1)
            if daemon_alive():
                return
        raise SystemExit(
            "play: remote mpv daemon failed to start "
            "(check /tmp/mpv-daemon.log on the remote)"
        )

    # Fetch remote $HOME once so we can build absolute paths.
    remote_home = ssh("echo $HOME").stdout.decode().strip()

    def upload(local: Path) -> str:
        abs_path = local.resolve()
        h = hashlib.sha256(str(abs_path).encode()).hexdigest()[:12]
        remote_name = f"{h}-{abs_path.name}"
        remote_rel = f"{REMOTE_UPLOAD_DIR}/{remote_name}"

        ssh(f"mkdir -p ~/{REMOTE_UPLOAD_DIR}")
        subprocess.run(
            ["scp", *SSH_OPTS, "-q", str(abs_path), f"{host}:{remote_rel}"],
            check=True,
        )
        return f"{remote_home}/{remote_rel}"

    ensure_daemon()

    for inp in args.inputs:
        if is_url(inp):
            target = inp
        else:
            p = Path(inp)
            if not p.is_file():
                print(f"play: not a file or URL: {inp}", file=sys.stderr)
                return 1
            target = upload(p)
        ipc("loadfile", target, mpv_mode)

    return 0


if __name__ == "__main__":
    sys.exit(main())
